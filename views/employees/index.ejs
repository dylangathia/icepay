<%- include('../partials/header') %>
<div class="page-head">
  <div><h1>Employees</h1><div class="muted"><%= employees.length %> shown</div></div>
  <% if (can('employees.manage')) { %><div class="actions"><a class="btn" href="/employees/new">Add employee</a></div><% } %>
</div>

<form class="inline-form" method="get" style="margin-bottom:16px">
  <div class="field"><input name="q" value="<%= q || '' %>" placeholder="Search name, number or ID"></div>
  <div class="field">
    <select name="status">
      <option value="">All statuses</option>
      <% for (const s of ['ACTIVE', 'SUSPENDED', 'TERMINATED']) { %>
        <option value="<%= s %>" <%= status === s ? 'selected' : '' %>><%= s.charAt(0) + s.slice(1).toLowerCase() %></option>
      <% } %>
    </select>
  </div>
  <button class="btn-secondary">Filter</button>
</form>

<div class="table-wrap">
  <table>
    <thead><tr><th>No.</th><th>Name</th><th>Department</th><th>Designation</th><th>KRA PIN</th><th class="num">Basic salary</th><th>Status</th></tr></thead>
    <tbody>
      <% for (const e of employees) { %>
        <tr>
          <td><a href="/employees/<%= e.id %>"><%= e.emp_no %></a></td>
          <td><a href="/employees/<%= e.id %>"><%= e.first_name %> <%= e.last_name %></a></td>
          <td><%= e.department || '—' %></td>
          <td><%= e.designation || '—' %></td>
          <td><%= e.kra_pin || '—' %></td>
          <td class="num"><%= money(e.basic_salary) %></td>
          <td><span class="badge badge-<%= e.status %>"><%= e.status %></span></td>
        </tr>
      <% } %>
      <% if (employees.length === 0) { %><tr><td colspan="7" class="muted">No employees found.</td></tr><% } %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>
