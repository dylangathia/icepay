<%- include('../partials/header') %>
<% const e = employee; const v = (f) => e[f] ?? ''; %>
<div class="page-head"><h1><%= title %></h1></div>

<form method="post" action="<%= e.id ? `/employees/${e.id}` : '/employees' %>">
  <div class="card">
    <fieldset>
      <legend>Personal details</legend>
      <div class="form-grid">
        <div class="field"><label>Employee number *</label><input name="emp_no" value="<%= v('emp_no') %>" required></div>
        <div class="field"><label>First name *</label><input name="first_name" value="<%= v('first_name') %>" required></div>
        <div class="field"><label>Middle name</label><input name="middle_name" value="<%= v('middle_name') %>"></div>
        <div class="field"><label>Last name *</label><input name="last_name" value="<%= v('last_name') %>" required></div>
        <div class="field"><label>Gender</label>
          <select name="gender">
            <option value=""></option>
            <% for (const g of ['Male', 'Female', 'Other']) { %><option <%= e.gender === g ? 'selected' : '' %>><%= g %></option><% } %>
          </select>
        </div>
        <div class="field"><label>Date of birth</label><input type="date" name="date_of_birth" value="<%= v('date_of_birth') %>"></div>
        <div class="field"><label>National ID / Passport</label><input name="id_number" value="<%= v('id_number') %>"></div>
        <div class="field"><label>Email (for payslips)</label><input type="email" name="email" value="<%= v('email') %>"></div>
        <div class="field"><label>Phone</label><input name="phone" value="<%= v('phone') %>"></div>
      </div>
    </fieldset>
  </div>

  <div class="card">
    <fieldset>
      <legend>Statutory numbers</legend>
      <div class="form-grid">
        <div class="field"><label>KRA PIN</label><input name="kra_pin" value="<%= v('kra_pin') %>" placeholder="A123456789Z" pattern="[AaPp][0-9]{9}[A-Za-z]"></div>
        <div class="field"><label>NSSF number</label><input name="nssf_no" value="<%= v('nssf_no') %>"></div>
        <div class="field"><label>SHIF / SHA number</label><input name="shif_no" value="<%= v('shif_no') %>"></div>
      </div>
    </fieldset>
  </div>

  <div class="card">
    <fieldset>
      <legend>Employment</legend>
      <div class="form-grid">
        <div class="field"><label>Hire date *</label><input type="date" name="hire_date" value="<%= v('hire_date') %>" required></div>
        <div class="field"><label>Department</label>
          <select name="department_id" id="department_id">
            <option value=""></option>
            <% for (const d of departments) { %><option value="<%= d.id %>" <%= e.department_id === d.id ? 'selected' : '' %>><%= d.name %></option><% } %>
          </select>
        </div>
        <div class="field"><label>Sub-department</label>
          <select name="sub_department_id" id="sub_department_id">
            <option value=""></option>
            <% for (const s of subDepartments) { %><option value="<%= s.id %>" data-dept="<%= s.department_id %>" <%= e.sub_department_id === s.id ? 'selected' : '' %>><%= s.name %></option><% } %>
          </select>
        </div>
        <div class="field"><label>Designation</label>
          <select name="designation_id">
            <option value=""></option>
            <% for (const d of designations) { %><option value="<%= d.id %>" <%= e.designation_id === d.id ? 'selected' : '' %>><%= d.name %></option><% } %>
          </select>
        </div>
        <div class="field"><label>Basic salary (KES / month) *</label><input type="number" step="0.01" min="0" name="basic_salary" value="<%= v('basic_salary') %>" required></div>
        <div class="field"><label>Insurance premiums paid privately (KES / month)</label><input type="number" step="0.01" min="0" name="insurance_premium" value="<%= e.insurance_premium || 0 %>"></div>
      </div>
      <p class="muted small">
        Joiners hired mid-month are paid for the days from their hire date.
        Enter life, education or health insurance premiums the employee pays outside payroll (with proof of payment) to give them insurance relief.
      </p>
      <% if (departments.length === 0 || designations.length === 0) { %>
        <p class="muted small">Set up <a href="/settings/departments">departments</a> and <a href="/settings/designations">designations</a> in Settings.</p>
      <% } %>
    </fieldset>
  </div>

  <div class="card">
    <fieldset>
      <legend>Payment</legend>
      <div class="form-grid">
        <div class="field"><label>Payment mode</label>
          <select name="payment_mode">
            <% for (const [val, lbl] of [['BANK', 'Bank transfer'], ['MPESA', 'M-Pesa'], ['CHEQUE', 'Cheque'], ['CASH', 'Cash']]) { %>
              <option value="<%= val %>" <%= e.payment_mode === val ? 'selected' : '' %>><%= lbl %></option>
            <% } %>
          </select>
        </div>
        <div class="field"><label>Bank name</label><input name="bank_name" value="<%= v('bank_name') %>"></div>
        <div class="field"><label>Branch</label><input name="bank_branch" value="<%= v('bank_branch') %>"></div>
        <div class="field"><label>Account / M-Pesa number</label><input name="account_no" value="<%= v('account_no') %>"></div>
      </div>
    </fieldset>
  </div>

  <div class="actions">
    <button><%= e.id ? 'Save changes' : 'Add employee' %></button>
    <a class="btn btn-secondary" href="<%= e.id ? `/employees/${e.id}` : '/employees' %>">Cancel</a>
  </div>
</form>

<script>
  // Only show sub-departments belonging to the chosen department
  const dept = document.getElementById('department_id');
  const sub = document.getElementById('sub_department_id');
  function filterSubs() {
    for (const opt of sub.options) {
      if (!opt.value) continue;
      opt.hidden = opt.dataset.dept !== dept.value;
      if (opt.hidden && opt.selected) sub.value = '';
    }
  }
  dept.addEventListener('change', filterSubs);
  filterSubs();
</script>
<%- include('../partials/footer') %>
