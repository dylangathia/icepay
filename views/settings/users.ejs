<%- include('../partials/header') %>
<div class="table-wrap">
  <table>
    <thead><tr><th>Username</th><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th>Last sign-in</th><th></th></tr></thead>
    <tbody>
      <% for (const u of users) { %>
        <tr>
          <td><strong><%= u.username %></strong><%= u.id === user.id ? ' (you)' : '' %></td>
          <td><%= u.full_name || '—' %></td>
          <td><%= u.email || '—' %></td>
          <td><%= ROLES[u.role] || u.role %></td>
          <td>
            <span class="badge <%= u.active ? 'badge-ACTIVE' : 'badge-muted' %>"><%= u.active ? 'ACTIVE' : 'INACTIVE' %></span>
            <% if (u.must_change_password) { %><span class="badge badge-SUSPENDED">TEMP PASSWORD</span><% } %>
          </td>
          <td class="muted small"><%= u.last_login_at || 'Never' %></td>
          <td class="right"><a class="btn btn-sm btn-secondary" href="/settings/users/<%= u.id %>/edit">Edit</a></td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>

<div class="grid grid-2">
  <form class="card" method="post" action="/settings/users">
    <h2>Add user</h2>
    <div class="form-grid">
      <div class="field"><label>Username *</label><input name="username" required pattern="[A-Za-z0-9._\-]{3,32}" autocomplete="off"></div>
      <div class="field"><label>Full name</label><input name="full_name"></div>
      <div class="field"><label>Email</label><input type="email" name="email"></div>
      <div class="field"><label>Role *</label>
        <select name="role" required>
          <% for (const [value, label] of Object.entries(ROLES)) { %>
            <option value="<%= value %>" <%= value === 'PAYROLL_OFFICER' ? 'selected' : '' %>><%= label %></option>
          <% } %>
        </select>
      </div>
      <div class="field"><label>Temporary password *</label><input type="password" name="password" minlength="8" required autocomplete="new-password"></div>
    </div>
    <p class="muted small">The user must change this password the first time they sign in.</p>
    <button>Add user</button>
  </form>

  <div class="card">
    <h2>What each role can do</h2>
    <div class="table-wrap" style="margin:0">
      <table>
        <thead><tr><th></th><th>Admin</th><th>Officer</th><th>Approver</th><th>Viewer</th></tr></thead>
        <tbody>
          <% for (const [label, roles] of [
            ['View employees, payroll, payslips', Object.keys(ROLES)],
            ['Manage employees', PERMISSIONS['employees.manage']],
            ['Manage benefits & deductions', PERMISSIONS['payitems.manage']],
            ['Open payroll periods', PERMISSIONS['periods.manage']],
            ['Process & roll back payroll', PERMISSIONS['payroll.process']],
            ['Post payroll', PERMISSIONS['payroll.post']],
            ['Email payslips', PERMISSIONS['payroll.email']],
            ['View audit log', PERMISSIONS['audit.view']],
            ['Settings', PERMISSIONS['settings.manage']],
            ['Manage users', PERMISSIONS['users.manage']],
          ]) { %>
            <tr>
              <td><%= label %></td>
              <% for (const r of ['ADMIN', 'PAYROLL_OFFICER', 'APPROVER', 'VIEWER']) { %>
                <td><%= roles.includes(r) ? '✓' : '' %></td>
              <% } %>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
