<%- include('../partials/header') %>
<div class="grid grid-2">
  <form class="card" method="post" action="/settings/mail">
    <h2>SMTP server</h2>
    <div class="form-grid">
      <div class="field"><label>Host</label><input name="host" value="<%= mail.host || '' %>" placeholder="smtp.gmail.com"></div>
      <div class="field"><label>Port</label><input type="number" name="port" value="<%= mail.port || 587 %>"></div>
      <div class="field"><label>Username</label><input name="username" value="<%= mail.username || '' %>" autocomplete="off"></div>
      <div class="field"><label>Password <%= mail.password ? '(saved – leave blank to keep)' : '' %></label><input type="password" name="password" autocomplete="new-password"></div>
      <div class="field"><label>From email</label><input type="email" name="from_email" value="<%= mail.from_email || '' %>"></div>
      <div class="field"><label>From name</label><input name="from_name" value="<%= mail.from_name || '' %>" placeholder="Payroll"></div>
    </div>
    <div class="field"><label class="check"><input type="checkbox" name="secure" value="1" <%= mail.secure ? 'checked' : '' %>> Use SSL/TLS (port 465). Leave unchecked for STARTTLS on 587.</label></div>
    <button>Save</button>
  </form>
  <form class="card" method="post" action="/settings/mail/test">
    <h2>Send a test email</h2>
    <p class="muted">Save your settings first, then send a test message.</p>
    <div class="field"><label>Send to</label><input type="email" name="to" required></div>
    <button class="btn-secondary">Send test</button>
  </form>
</div>
<%- include('../partials/footer') %>
