<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Sign in · IcePay</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="login">
    <span class="brand">Ice<span>Pay</span></span>
    <% if (flash) { %><div class="flash flash-<%= flash.type %>"><%= flash.message %></div><% } %>
    <form class="card" method="post" action="/login">
      <div class="field"><label for="username">Username</label><input id="username" name="username" required autofocus></div>
      <div class="field"><label for="password">Password</label><input id="password" name="password" type="password" required></div>
      <button style="width:100%;justify-content:center">Sign in</button>
    </form>
  </div>
</body>
</html>
