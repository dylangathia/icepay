<%- include('partials/header') %>
<div class="page-head"><h1>Change password</h1></div>
<% if (forced) { %>
  <div class="notice">You must set a new password before continuing.</div>
<% } %>
<form class="card" method="post" action="/account/password" style="max-width:420px">
  <div class="field"><label>Current password</label><input type="password" name="current" required></div>
  <div class="field"><label>New password (min. 8 characters)</label><input type="password" name="password" minlength="8" required></div>
  <div class="field"><label>Confirm new password</label><input type="password" name="confirm" minlength="8" required></div>
  <button>Change password</button>
</form>
<%- include('partials/footer') %>
